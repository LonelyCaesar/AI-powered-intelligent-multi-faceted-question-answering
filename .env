# Environment Variables Template
# Copy this file to .env and replace the values with your actual configuration.

# Local Ollama Model (Default is gemma4, you can change to llama3 or qwen2)
OLLAMA_MODEL=gemma4
# Flask Environment (development/production)
FLASK_ENV=development

# Database Configuration
# You can choose one of the following depending on your database setup:

# 1. SQLite (Default, stores in instance/complaints.db)
# DATABASE_URL=sqlite:///your_custom_db.db

# 2. MySQL (Requires PyMySQL)
# DATABASE_URL=mysql+pymysql://username:password@localhost/db_name

# 3. SQL Server (Requires pyodbc and ODBC Driver installed on Windows)
DATABASE_URL="mssql+pyodbc://@DESKTOP-TDKO9FU\SQL2022/complaint_db?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"
